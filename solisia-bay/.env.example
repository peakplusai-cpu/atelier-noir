# --- Public site origin (used for Creem success redirect + canonical URLs) ---
SITE_ORIGIN=http://localhost:3200

# --- Creem (https://creem.io) ---
# API key from Creem dashboard -> Developers. Keys starting with creem_test_ use the test API automatically.
CREEM_API_KEY=
# One-time USD product used as the "order" carrier. The real amount is sent per checkout via custom_price.
CREEM_PRODUCT_ID=
# Signing secret of the webhook pointing to https://<your-domain>/api/webhooks/creem
CREEM_WEBHOOK_SECRET=
# Optional override: "test" or "live" (default: inferred from the API key prefix)
CREEM_ENV=

# --- Supabase (same project as Radiant; tables are prefixed solisia_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
