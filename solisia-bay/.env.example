# --- Public site origin (canonical URLs + order links) ---
SITE_ORIGIN=http://localhost:3200

# --- PayPal Checkout (https://developer.paypal.com) ---
# REST app credentials. The client id is public (it is loaded by the PayPal JS SDK in the browser);
# the secret stays on the server.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "live"
PAYPAL_ENV=sandbox

# --- Supabase (same project as Radiant; tables are prefixed solisia_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required on Vercel. Cron requests must send Authorization: Bearer <this value>.
# Use a long random string. Vercel sends it automatically when this variable is set.
CRON_SECRET=

# Optional. When set, the first visit to /admin/setup must submit this exact token.
# Set a long random value before the site is public. Leave empty only for local setup.
STAFF_SETUP_TOKEN=
