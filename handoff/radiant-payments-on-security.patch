+  identity: { lineUserId: "", lineName: "王小明", lineId: "", verified: false, phone: "0912345678" },
+  ...patch,
+});
+
+function gatewayResponse(amount: number, orderNo: string, status = "SUCCESS") {
+  const cipher = createCipheriv("aes-256-cbc", KEY, IV);
+  const body = JSON.stringify({ Status: status, Result: { MerchantID: "MS12345678", Amt: amount, TradeNo: "T1", MerchantOrderNo: orderNo, PaymentType: "CREDIT" } });
+  const tradeInfo = Buffer.concat([cipher.update(body), cipher.final()]).toString("hex");
+  const sha = createHash("sha256").update(`HashIV=${IV}&${tradeInfo}&HashKey=${KEY}`).digest("hex").toUpperCase();
+  return { tradeInfo, sha };
+}
