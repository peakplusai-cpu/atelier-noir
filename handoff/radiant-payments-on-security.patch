+    expect(verifyTradeSha(good.tradeInfo, "0".repeat(64), KEY, IV)).toBe(false);
+    expect(verifyTradeSha(good.tradeInfo, good.sha, KEY, "ZZZZZZZZZZZZZZZZ")).toBe(false);
+    expect(decryptTradeInfo("not-hex", KEY, IV)).toBeNull();
+  });
