+    expect(stored).toMatchObject({ status: "paid", paymentStatus: "paid", payType: "CREDIT" });
+  });
+
+  it("cancels stale unpaid orders, restores stock, and spares paid, cod and fresh ones", async () => {
+    const { placeOrder, sweepExpiredOrders } = await import("@/lib/orders");
+    const { getStore, mutate } = await import("@/lib/store");
+    const stock = () => getStore().then((store) => store.products[0].variants[0].stock);
+    const stockBefore = await stock();
+    const stale = await placeOrder(input({ paymentMethod: "offline" }));
+    const cod = await placeOrder(input({ fulfillment: "cvs", cvsBrand: "7-ELEVEN", cvsStoreName: "信義", cvsStoreCode: "123456", paymentMethod: "cod" }));
+    const fresh = await placeOrder(input({ paymentMethod: "offline" }));
+    if (!stale.ok || !cod.ok || !fresh.ok) throw new Error("setup failed");
+    const longAgo = new Date(Date.now() - 8 * 86400000).toISOString();
+    await mutate((store) => {
+      for (const order of store.orders) if (order.id === stale.order.id || order.id === cod.order.id) order.createdAt = longAgo;
+    });
+    const before = await stock();
+    expect(await sweepExpiredOrders()).toBe(1);
+    const after = await getStore();
+    expect(after.orders.find((order) => order.id === stale.order.id)?.status).toBe("cancelled");
+    expect(after.orders.find((order) => order.id === cod.order.id)?.status).toBe("pending");
+    expect(after.orders.find((order) => order.id === fresh.order.id)?.status).toBe("pending");
+    expect(after.products[0].variants[0].stock).toBe(before + 1);
+    expect(stockBefore).toBeGreaterThan(0);
+  });
+
+  it("rejects online payment and cvs when they are switched off", async () => {
+    const { placeOrder } = await import("@/lib/orders");
+    const { mutate } = await import("@/lib/store");
+    await mutate((store) => {
+      store.settings.payOnlineEnabled = false;
+      store.settings.cvsEnabled = false;
+    });
+    expect((await placeOrder(input())).ok).toBe(false);
+    expect((await placeOrder(input({ fulfillment: "cvs", cvsBrand: "全家", cvsStoreName: "信義", cvsStoreCode: "123456", paymentMethod: "offline" }))).ok).toBe(false);
+  });
+});
