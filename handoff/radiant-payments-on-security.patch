+const dir = mkdtempSync(join(tmpdir(), "radiant-pay-"));
+process.env.RADIANT_DATA_FILE = join(dir, "store.json");
+process.env.NEWEBPAY_MERCHANT_ID = "MS12345678";
+process.env.NEWEBPAY_HASH_KEY = "abcdefghijklmnopqrstuvwxyz012345";
+process.env.NEWEBPAY_HASH_IV = "ABCDEFGHIJKLMNOP";
+const KEY = process.env.NEWEBPAY_HASH_KEY;
+const IV = process.env.NEWEBPAY_HASH_IV;
+
+const input = (patch: Partial<CheckoutInput> = {}): CheckoutInput => ({
+  lines: [{ productId: "prd_p", variantId: "var_p", qty: 1 }],
+  recipient: "王小明",
